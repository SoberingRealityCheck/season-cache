{
  "schemaVersion": 1,
  "id": "seasoncache",
  "version": "${version}",
  "name": "Season Cache",
  "description": "Keeps snow and ice in sync with Serene Seasons. Removes snow in spring, places it in winter, and drives LOD shader snow coverage for Nova Reimagined and Distant Horizons.",
  "authors": [
    "ItsThatNova",
    "SoberingRealityCheck (26.2 port)"
  ],
  "contact": {
    "homepage": "https://github.com/SoberingRealityCheck/season-cache",
    "sources": "https://github.com/SoberingRealityCheck/season-cache",
    "issues": "https://github.com/SoberingRealityCheck/season-cache/issues"
  },
  "license": "MIT",
  "icon": "assets/seasoncache/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.seasoncache.SeasonCacheMod"
    ],
    "client": [
      "com.seasoncache.client.SeasonCacheClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": ">=26.2",
    "fabric-api": "*",
    "sereneseasons": "*"
  }
}
