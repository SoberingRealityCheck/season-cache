{
  "schemaVersion": 1,
  "id": "seasoncache",
  "version": "${version}",
  "name": "Seasonal Terrain",
  "description": "Makes the world follow Serene Seasons. Seasonal snow and ice on loaded chunks, and season colors and snow on Distant Horizons terrain, with no shader needed.",
  "authors": [
    "ItsThatNova",
    "SoberingRealityCheck (26.2 port)"
  ],
  "contact": {
    "homepage": "https://github.com/SoberingRealityCheck/season-cache",
    "sources": "https://github.com/SoberingRealityCheck/season-cache",
    "issues": "https://github.com/SoberingRealityCheck/season-cache/issues"
  },
  "license": "MIT",
  "icon": "assets/seasoncache/icon.png",
  "environment": "*",
  "mixins": [
    "seasoncache.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.seasoncache.SeasonCacheMod"
    ],
    "client": [
      "com.seasoncache.client.SeasonCacheClient"
    ]
  },
  "suggests": {
    "distanthorizons": "~3.3.2"
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": ">=26.2",
    "fabric-api": "*",
    "sereneseasons": "*"
  }
}
